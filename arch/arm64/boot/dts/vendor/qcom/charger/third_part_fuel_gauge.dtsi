									0x9590 0x9551 0x9515 0x94DA 0x94A2 0x946B>;  //NTC value(DEC) table -30~75, 110K PU/10k NTC
			battery1,param_version = <7>;
			battery1,max_voltage_uv = <4423000>;
			battery1,battery_type = <4423 0x0 0x1EC6>;
			battery1,battery_table0 = <0x1400 0x1B32 0x1BF8 0x1CD5 0x1D5F 0x1D85 0x1D8D 0x1D9E 0x1DE2 0x1E27 0x1E65 0x1EB1 0x1F06 0x1F5D 0x1FB2 0x1FE1 0x203F 0x20A9 0x211C 0x21D4 0x222E 0x22D3 0x2317 0x24CC>;
			battery1,battery_table1 = <0x0 0x66 0x148 0x2DC 0x46F 0x689 0x8A2 0xC4F 0x118F 0x1970 0x2150 0x2BD1 0x33B1 0x38F1 0x3B91 0x3E31 0x4371 0x48B2 0x4DF2 0x55D2 0x597F 0x60D9 0x6400 0x64E6>;
			battery1,battery_table2 = <0x1D24 0x181A 0x1517 0x1314 0x1112 0x1011 0x1010 0x0E0E>;
			battery1,alpha = <0x00CC>;
			battery1,beta = <0x0025>;
			battery1,rs = <0x005F>;
			battery1,rs_value = <0x0050 0x010A 0x3800 0x0048>;
			battery1,vit_period = <0x315A>;
			battery1,volt_cal = <0x8000>;
